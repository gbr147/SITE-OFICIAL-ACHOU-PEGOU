<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title><%= post.titulo %> - Achou? Pegou!</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #121212; color: #f5f5f5; padding: 20px; }
        .container { max-width: 650px; margin: 0 auto; background: #1e1e1e; padding: 30px; border-radius: 12px; border: 1px solid #ff6600; }
        .back { text-decoration: none; color: #ff6600; font-weight: bold; display: inline-block; margin-bottom: 25px; }
        img { max-width: 100%; border-radius: 8px; border: 1px solid #333; margin: 20px 0; display:block;}
        .comment-section { margin-top: 35px; border-top: 1px solid #333; padding-top: 20px; }
        .comment { background: #121212; padding: 15px; border-radius: 6px; margin-bottom: 12px; border-left: 4px solid #ff6600; }
        input, textarea, button { width: 100%; padding: 12px; margin-bottom: 15px; border: 1px solid #333; background: #121212; color: white; border-radius: 6px; box-sizing: border-box; }
        button { background: #ff6600; color: black; font-weight: bold; border: none; cursor: pointer; }
    </style>
</head>
<body>
    <div class="container">
        <a class="back" href="/">⬅ Voltar para o Feed</a>
        <h1><%= post.titulo %></h1>
        <p style="color:#aaa; font-size:0.9rem; margin-top:-10px;">Postado por: <%= post.autorNome %></p>
        <p style="font-size: 1.1rem; line-height: 1.6;"><%= post.descricao %></p>
        
        <% if(post.imagem) { %> <img src="<%= post.imagem %>"> <% } %>

        <div class="comment-section">
            <h3 style="color: #ff6600;">💬 Painel de Pistas</h3>
            <% if(post.comentarios.length === 0) { %>
                <p style="color: #666;">Nenhum comentário público deixado nesta postagem.</p>
            <% } %>
            <% post.comentarios.forEach(c => { %>
                <div class="comment">
                    <strong style="color: #ff6600;"><%= c.autor %>:</strong> <%= c.texto %>
                </div>
            <% }) %>

            <h4 style="margin-top: 30px;">Deixar uma Resposta:</h4>
            <form action="/item/<%= post.id %>/comentario" method="POST">
                <% if(!usuarioLogado) { %>
                    <input type="text" name="autor" placeholder="Seu Apelido (Visitante)">
                <% } %>
                <textarea name="texto" rows="3" placeholder="Escreva informações úteis aqui..." required></textarea>
                <button type="submit">Enviar Comentário</button>
            </form>
        </div>
    </div>
</body>
</html>
